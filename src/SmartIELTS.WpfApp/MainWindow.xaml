<Window x:Class="SmartIELTS.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SmartIELTS Examination System - Kiosk Mode" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BgPage}"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- ============================================================
             DESIGN SYSTEM - LIGHT THEME
             Giữ nguyên tên các key cũ (BgDark, BgSurface, BgCard, PrimaryTeal,
             AccentBlue, TextLight, TextMuted, DangerRed, SuccessGreen,
             WarningYellow) vì code-behind gọi FindResource trực tiếp.
             ============================================================ -->

        <!-- Nền -->
        <SolidColorBrush x:Key="BgPage" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="BgSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgSubtle" Color="#EEF2F7"/>
        <SolidColorBrush x:Key="BgRowAlt" Color="#FAFBFC"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#DDE3EA"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#C3CCD8"/>

        <!-- Chữ -->
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="BodyText" Color="#334155"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7A90"/>

        <!-- Thương hiệu & trạng thái -->
        <SolidColorBrush x:Key="PrimaryTeal" Color="#0F766E"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#0D9488"/>
        <SolidColorBrush x:Key="PrimarySoft" Color="#E6F4F2"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#E8EEFE"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#0E9F6E"/>
        <SolidColorBrush x:Key="SuccessSoft" Color="#E3F5EC"/>
        <SolidColorBrush x:Key="WarningYellow" Color="#B45309"/>
        <SolidColorBrush x:Key="WarningSoft" Color="#FDF3E3"/>
        <SolidColorBrush x:Key="DangerRed" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerSoft" Color="#FDECEA"/>

        <!-- Alias tương thích (một số chỗ dùng tên cũ) -->
        <SolidColorBrush x:Key="BgDark" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextLight" Color="#0F172A"/>

        <!-- ============================================================
             TYPOGRAPHY
             ============================================================ -->
        <Style x:Key="TextHero" TargetType="TextBlock">
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTeal}"/>
        </Style>

        <Style x:Key="TextH1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="TextH2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="TextH3" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="TextBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource BodyText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>

        <Style x:Key="TextSmall" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <Style x:Key="TextCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <!-- ============================================================
             BUTTONS
             ============================================================ -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryTeal}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút phụ: nền xám nhạt -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BgSubtle}"/>
            <Setter Property="Foreground" Value="{StaticResource BodyText}"/>
        </Style>

        <!-- Nút nguy hiểm dạng đặc -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerRed}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Nút nguy hiểm dạng viền (nhẹ mắt hơn trên nền sáng) -->
        <Style x:Key="DangerOutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerRed}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource DangerRed}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút chọn vai trò ở màn đăng nhập -->
        <Style x:Key="RoleChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource BodyText}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderStrong}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoft}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryTeal}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             INPUTS
             ============================================================ -->
        <!--
            KHÔNG tự viết ControlTemplate cho TextBox.
            Lý do: template tự viết trước đây làm vùng nhập co lại -> toàn bộ ô nhập
            (kể cả trang đăng nhập) không click/gõ được.
            Chỉ set thuộc tính màu sắc/kích thước, giữ template mặc định của WPF.
        -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource BodyText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource PrimaryTeal}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryTeal}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource BgSubtle}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox nhiều dòng: chữ căn trên, dùng cho editor/transcript -->
        <Style x:Key="MultilineTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource BodyText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource BodyText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ============================================================
             LISTS / TABLES
             ============================================================ -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource BodyText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource BgSubtle}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource BodyText}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgRowAlt}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimarySoft}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource BodyText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource BodyText}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgRowAlt}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             SLIDER / PROGRESSBAR / SCROLL
             ============================================================ -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTeal}"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{StaticResource BgSubtle}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTeal}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="8"/>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="PanningMode" Value="VerticalOnly"/>
        </Style>

        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="Width" Value="1"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- ================================================================
             TOP HEADER BAR
             ================================================================ -->
        <Border Grid.Row="0" Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource PrimaryTeal}" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="AI" Foreground="White" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SmartIELTS Exam Platform" Foreground="{StaticResource TextPrimary}"
                                   FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="SWD392 Architecture &amp; PRN222 .NET 8" Foreground="{StaticResource TextMuted}"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: candidate + timer -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{StaticResource BgSubtle}" CornerRadius="999" Padding="14,5" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtCandidateBadge" Text="Thí sinh: Chưa đăng nhập"
                                   Foreground="{StaticResource BodyText}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBlue}"
                            BorderThickness="1" CornerRadius="999" Padding="14,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱" Foreground="{StaticResource AccentBlue}" FontSize="13" Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Còn lại " Foreground="{StaticResource BodyText}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTimer" Text="165:00" Foreground="{StaticResource AccentBlue}"
                                       FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: badges + controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BadgeKiosk" Background="{StaticResource SuccessSoft}"
                            BorderBrush="{StaticResource SuccessGreen}" BorderThickness="1"
                            CornerRadius="999" Padding="12,5" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtKioskStatus" Text="🔒 KIOSK LOCK ACTIVE"
                                   Foreground="{StaticResource SuccessGreen}" FontSize="11" FontWeight="Bold"/>
                    </Border>

                    <Border x:Name="BadgeRealtime" Background="{StaticResource AccentSoft}"
                            BorderBrush="{StaticResource AccentBlue}" BorderThickness="1"
                            CornerRadius="999" Padding="12,5" Margin="0,0,8,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtRealtimeStatus" Text="Realtime: Ngoại tuyến"
                                   Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="Bold"/>
                    </Border>

                    <Button x:Name="BtnToggleKiosk" Content="Tạm dừng Lock" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="BtnToggleKiosk_Click" Padding="12,6" FontSize="12"/>
                    <Button x:Name="BtnLogout" Content="Đăng Xuất" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="BtnLogout_Click" Padding="12,6" FontSize="12" Visibility="Collapsed"/>
                    <Button Content="Thoát" Style="{StaticResource DangerOutlineButton}"
                            Click="BtnExitApp_Click" Padding="12,6" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================
             MAIN BODY
             ================================================================ -->
        <Grid Grid.Row="1" Margin="20">

            <!-- ==================== VIEW 1: LOGIN ==================== -->
            <Border x:Name="ViewLogin" Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                    CornerRadius="10" Padding="32" MaxWidth="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Border Background="{StaticResource PrimaryTeal}" CornerRadius="10" Width="48" Height="48"
                            HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="AI" Foreground="White" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Hệ Thống Khảo Thí SmartIELTS" Style="{StaticResource TextH1}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Thí sinh làm bài · Giám thị giám sát · Giám khảo duyệt điểm"
                               Style="{StaticResource TextSmall}" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,0,0,20"/>

                    <!-- Quick role chips -->
                    <Border Background="{StaticResource BgSubtle}" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Chọn nhanh vai trò (demo)" Foreground="{StaticResource TextMuted}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <UniformGrid Columns="3">
                                <Button Content="Thí sinh" Style="{StaticResource RoleChipButton}"
                                        Padding="8,7" Margin="0,0,4,0" Click="BtnQuickRole_Click" Tag="student"/>
                                <Button Content="Giám thị" Style="{StaticResource RoleChipButton}"
                                        Padding="8,7" Margin="2,0,2,0" Click="BtnQuickRole_Click" Tag="teacher"/>
                                <Button Content="Quản trị" Style="{StaticResource RoleChipButton}"
                                        Padding="8,7" Margin="4,0,0,0" Click="BtnQuickRole_Click" Tag="admin"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Tên đăng nhập" Foreground="{StaticResource BodyText}"
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtUsername" Text="student" Height="38" Margin="0,0,0,14"/>

                    <TextBlock Text="Mật khẩu" Foreground="{StaticResource BodyText}"
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtPassword" Password="Student@123" Height="38" Margin="0,0,0,20"/>

                    <!-- Hardware check -->
                    <Border Background="{StaticResource BgSubtle}" CornerRadius="8" Padding="14" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Kiểm tra thiết bị &amp; bảo mật" Foreground="{StaticResource TextPrimary}"
                                       FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Text="✓  Camera: sẵn sàng cho giám sát" Foreground="{StaticResource BodyText}"
                                       FontSize="12" Margin="0,2"/>
                            <TextBlock Text="✓  Microphone: sẵn sàng cho phần Speaking" Foreground="{StaticResource BodyText}"
                                       FontSize="12" Margin="0,2"/>
                            <TextBlock Text="✓  Kiosk Hook: tự động khóa Alt+Tab, Windows Key" Foreground="{StaticResource BodyText}"
                                       FontSize="12" Margin="0,2"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Đăng Nhập Vào Hệ Thống" Height="46" FontSize="15" Click="BtnStartExam_Click"/>
                </StackPanel>
            </Border>

            <!-- ==================== VIEW 1b: CANDIDATE HOME (chọn chức năng) ==================== -->
            <Grid x:Name="ViewCandidateHome" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720">
                    <TextBlock Text="Chào mừng trở lại" Style="{StaticResource TextH1}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtHomeCandidateName" Text="Thí sinh"
                               Style="{StaticResource TextSmall}" HorizontalAlignment="Center"
                               Margin="0,0,0,28"/>

                    <UniformGrid Columns="2">
                        <!-- Vào phòng thi -->
                        <Border Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="10" Padding="24" Margin="0,0,10,0" Cursor="Hand"
                                MouseLeftButtonUp="CardStartExam_Click">
                            <StackPanel>
                                <Border Background="{StaticResource PrimarySoft}" CornerRadius="10"
                                        Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,14">
                                    <TextBlock Text="✎" FontSize="24" Foreground="{StaticResource PrimaryTeal}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Vào phòng thi" Style="{StaticResource TextH3}" FontSize="16"/>
                                <TextBlock Text="Bắt đầu ca thi mới và làm bài 4 kỹ năng Listening, Reading, Writing, Speaking."
                                           Foreground="{StaticResource TextMuted}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Coi điểm -->
                        <Border Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="10" Padding="24" Margin="10,0,0,0" Cursor="Hand"
                                MouseLeftButtonUp="CardViewResults_Click">
                            <StackPanel>
                                <Border Background="{StaticResource AccentSoft}" CornerRadius="10"
                                        Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,14">
                                    <TextBlock Text="📊" FontSize="24" Foreground="{StaticResource AccentBlue}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Coi điểm của tôi" Style="{StaticResource TextH3}" FontSize="16"/>
                                <TextBlock Text="Xem lại kết quả các ca thi đã làm và trạng thái duyệt điểm của giảng viên."
                                           Foreground="{StaticResource TextMuted}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock x:Name="TxtHomeHint" Text=""
                               Foreground="{StaticResource TextMuted}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,24,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- ==================== VIEW 1c: CANDIDATE RESULT HISTORY ==================== -->
            <Grid x:Name="ViewCandidateResults" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgSurface}"
                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                        CornerRadius="10" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Margin="0,0,240,0">
                                <TextBlock Text="Kết quả thi của tôi" Style="{StaticResource TextH2}" FontSize="17"/>
                                <TextBlock x:Name="TxtResultsSummary" Text="Chưa có ca thi nào."
                                           Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Làm mới" Style="{StaticResource SecondaryButton}"
                                        Click="BtnRefreshMyResults_Click" Padding="12,7" Margin="0,0,8,0" FontSize="12"/>
                                <Button Content="Quay lại" Style="{StaticResource SecondaryButton}"
                                        Click="BtnBackFromResults_Click" Padding="12,7" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- Bộ lọc -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtMyFilterKeyword" Grid.Column="0" Height="34" FontSize="13"
                                     ToolTip="Tìm theo tên đề thi" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CboMyFilterStatus" Grid.Column="1" Height="34" Margin="0,0,8,0"
                                      SelectionChanged="MyFilter_Changed" FontSize="12"/>
                            <ComboBox x:Name="CboMyFilterSkill" Grid.Column="2" Height="34" Margin="0,0,8,0"
                                      SelectionChanged="MyFilter_Changed" FontSize="12"/>
                            <ComboBox x:Name="CboMyFilterSort" Grid.Column="3" Height="34"
                                      SelectionChanged="MyFilter_Changed" FontSize="12"/>
                            <Button Grid.Column="4" Content="Tìm" HorizontalAlignment="Left" Margin="8,0,0,0"
                                    Padding="18,7" FontSize="12" Click="BtnApplyMyFilter_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource BgSurface}"
                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                        CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TxtNoResults" Text="Bạn chưa có ca thi nào. Hãy bấm “Vào phòng thi” để bắt đầu."
                                   Foreground="{StaticResource TextMuted}" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>

                        <ListBox x:Name="ListMyResults" Grid.Row="1" BorderThickness="0"
                                 SelectionChanged="ListMyResults_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgSubtle}" CornerRadius="8"
                                            Padding="14" Margin="0,4" BorderBrush="{StaticResource BorderSubtle}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding ExamTitle}" FontWeight="SemiBold"
                                                           FontSize="13" Foreground="{StaticResource TextPrimary}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0">
                                                    <Run Text="{Binding StartTime, StringFormat='Bắt đầu: {0:HH:mm dd/MM/yyyy}'}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource AccentBlue}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="150">
                                                <Border Background="{StaticResource PrimarySoft}" CornerRadius="6"
                                                        Padding="10,6">
                                                    <TextBlock Text="{Binding OverallScoreText}" FontWeight="Bold"
                                                               FontSize="13" Foreground="{StaticResource PrimaryTeal}"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding SkillSummary}" FontSize="10"
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== VIEW 2: EXAM WORKSPACE ==================== -->
            <Grid x:Name="ViewExam" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Skill tabs (segmented) -->
                <Border Grid.Row="0" Background="{StaticResource BgSubtle}" CornerRadius="8"
                        Padding="4" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TabListening" Content="1. Listening · 30m"
                                Background="{StaticResource PrimaryTeal}" Foreground="White"
                                Margin="0,0,4,0" Padding="18,9" FontSize="13" Click="TabSkill_Click" Tag="Listening"/>
                        <Button x:Name="TabReading" Content="2. Reading · 60m"
                                Background="Transparent" Foreground="{StaticResource BodyText}"
                                Margin="0,0,4,0" Padding="18,9" FontSize="13" Click="TabSkill_Click" Tag="Reading"/>
                        <Button x:Name="TabWriting" Content="3. Writing · 60m"
                                Background="Transparent" Foreground="{StaticResource BodyText}"
                                Margin="0,0,4,0" Padding="18,9" FontSize="13" Click="TabSkill_Click" Tag="Writing"/>
                        <Button x:Name="TabSpeaking" Content="4. Speaking · 15m"
                                Background="Transparent" Foreground="{StaticResource BodyText}"
                                Margin="0,0,0,0" Padding="18,9" FontSize="13" Click="TabSkill_Click" Tag="Speaking"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <!-- LISTENING -->
                    <Grid x:Name="PanelListening" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="10" Padding="16" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnPlayAudio" Content="▶  Phát Audio" Click="BtnPlayAudio_Click"
                                            Padding="14,7" Margin="0,0,12,0" FontSize="13"/>
                                    <TextBlock x:Name="TxtAudioStatus" Text="Audio Listening (phát 1 lần · khóa tua)"
                                               Foreground="{StaticResource BodyText}" FontWeight="SemiBold"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ProgressBar x:Name="BarAudioProgress" Grid.Column="1" Value="0" Maximum="100"
                                             Height="6" Margin="20,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtVolume" Grid.Column="2" Text="Volume 100%"
                                           Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="StackListeningQuestions" Margin="0,0,0,8"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- READING -->
                    <Grid x:Name="PanelReading" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="10" Padding="20">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="{StaticResource BgSubtle}" CornerRadius="6"
                                        Padding="10,8" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Công cụ đọc" Foreground="{StaticResource TextMuted}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Content="Highlight vàng" Style="{StaticResource SecondaryButton}"
                                                Background="{StaticResource WarningSoft}" Foreground="{StaticResource WarningYellow}"
                                                Padding="10,5" FontSize="11" Margin="0,0,6,0" Click="BtnHighlight_Click"/>
                                        <Button Content="Ghi chú" Style="{StaticResource SecondaryButton}"
                                                Padding="10,5" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="TxtReadingPassage" IsReadOnly="True" TextWrapping="Wrap"
                                             Background="Transparent" Foreground="{StaticResource BodyText}"
                                             FontSize="15" BorderThickness="0" Padding="0"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

                        <Border Grid.Column="2" Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="10" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="StackReadingQuestions"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- WRITING -->
                    <Grid x:Name="PanelWriting" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="10" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Đề bài IELTS Writing" Style="{StaticResource TextH3}"
                                               Margin="0,0,0,10"/>
                                    <Border Background="{StaticResource BgSubtle}" CornerRadius="8"
                                            Padding="14" Margin="0,0,0,16">
                                        <TextBlock x:Name="TxtWritingPrompt" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BodyText}" FontSize="13" LineHeight="21"/>
                                    </Border>

                                    <TextBlock Text="4 tiêu chí chấm Cambridge" Style="{StaticResource TextH3}"
                                               FontSize="13" Margin="0,0,0,8"/>

                                    <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}"
                                            BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource PrimarySoft}" CornerRadius="4"
                                                        Width="18" Height="18" VerticalAlignment="Top">
                                                    <TextBlock Text="1" Foreground="{StaticResource PrimaryTeal}"
                                                               FontSize="11" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Task Response (25%) — tối thiểu 250 từ, đúng trọng tâm"
                                                           Foreground="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource PrimarySoft}" CornerRadius="4"
                                                        Width="18" Height="18" VerticalAlignment="Top">
                                                    <TextBlock Text="2" Foreground="{StaticResource PrimaryTeal}"
                                                               FontSize="11" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Coherence &amp; Cohesion (25%) — bố cục logic, liên từ chặt chẽ"
                                                           Foreground="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource PrimarySoft}" CornerRadius="4"
                                                        Width="18" Height="18" VerticalAlignment="Top">
                                                    <TextBlock Text="3" Foreground="{StaticResource PrimaryTeal}"
                                                               FontSize="11" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Lexical Resource (25%) — vốn từ học thuật C1/C2"
                                                           Foreground="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource PrimarySoft}" CornerRadius="4"
                                                        Width="18" Height="18" VerticalAlignment="Top">
                                                    <TextBlock Text="4" Foreground="{StaticResource PrimaryTeal}"
                                                               FontSize="11" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Grammatical Range (25%) — đa dạng và chuẩn xác cấu trúc"
                                                           Foreground="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

                        <Border Grid.Column="2" Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="10" Padding="20">
                            <!--
                                Dùng Grid thay DockPanel: hàng "*" bảo đảm editor LUÔN lấp đầy
                                vùng còn lại và co giãn theo cửa sổ. Trước đây DockPanel +
                                Height="Auto" khiến ô nhập cao vượt khung -> không click/gõ được.
                            -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBox x:Name="TxtEssayEditor"
                                         Grid.Row="0"
                                         Style="{StaticResource MultilineTextBox}"
                                         MinHeight="200"
                                         VerticalAlignment="Stretch"
                                         TextChanged="TxtEssayEditor_TextChanged"
                                         PreviewKeyDown="TxtEssayEditor_PreviewKeyDown"/>

                                <Border Grid.Row="1" Background="{StaticResource BgSubtle}" CornerRadius="6"
                                        Padding="14,9" Margin="0,12,0,0">
                                    <Grid>
                                        <TextBlock x:Name="TxtWordCount"
                                                   Text="Số từ: 0 / 250 (khóa lệnh Paste)"
                                                   Foreground="{StaticResource PrimaryTeal}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Tự động lưu nháp mỗi 10 giây" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- SPEAKING -->
                    <Grid x:Name="PanelSpeaking" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="10" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{StaticResource BgSubtle}" CornerRadius="8"
                                        Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock x:Name="TxtSpeakingPartBadge" Text="PART 1 — INTRODUCTION &amp; INTERVIEW"
                                                       Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock x:Name="TxtSpeakingProgress" Text="Lượt 0 / 7"
                                                       HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ProgressBar x:Name="BarSpeakingProgress" Value="0" Maximum="7" Height="6"
                                                     Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Examiner question -->
                                        <Border Background="{StaticResource AccentSoft}" CornerRadius="10"
                                                Padding="16" Margin="0,0,0,12"
                                                BorderBrush="{StaticResource AccentBlue}" BorderThickness="1">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="GIÁM KHẢO HỎI" Foreground="{StaticResource AccentBlue}"
                                                               FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button x:Name="BtnReplayQuestion" Content="Nghe lại"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Click="BtnReplayQuestion_Click" Padding="10,4" FontSize="11"
                                                                Margin="0,0,6,0"/>
                                                        <Button x:Name="BtnToggleVoice" Content="Giọng: BẬT"
                                                                Click="BtnToggleVoice_Click" Padding="10,4" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock x:Name="TxtExaminerQuestion" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontSize="16" FontWeight="SemiBold" LineHeight="25"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Read & answer guide -->
                                        <Border Background="{StaticResource SuccessSoft}" CornerRadius="10"
                                                Padding="16" Margin="0,0,0,12"
                                                BorderBrush="{StaticResource SuccessGreen}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="ĐỌC VÀ TRẢ LỜI — gợi ý nội dung &amp; từ vựng"
                                                           Foreground="{StaticResource SuccessGreen}" FontWeight="Bold"
                                                           FontSize="11" Margin="0,0,0,8"/>
                                                <TextBlock x:Name="TxtCandidateGuide" TextWrapping="Wrap"
                                                           Foreground="{StaticResource BodyText}"
                                                           FontSize="13" LineHeight="22"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Timer -->
                                        <Border Background="{StaticResource BgSubtle}" CornerRadius="8"
                                                Padding="12" Margin="0,0,0,12">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⏱" Foreground="{StaticResource WarningYellow}"
                                                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtSpeakingTimer" Text="--:--"
                                                               Foreground="{StaticResource WarningYellow}"
                                                               FontWeight="Bold" FontSize="17" Margin="0,0,14,0"/>
                                                    <TextBlock x:Name="TxtSpeakingState"
                                                               Text="Bấm Bắt Đầu Trả Lời khi sẵn sàng."
                                                               Foreground="{StaticResource TextMuted}"
                                                               FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button x:Name="BtnSkipPreparation" Content="Bắt đầu nói ngay"
                                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                                        Click="BtnSkipPreparation_Click" Padding="10,5" FontSize="11"
                                                        Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="CÂU TRẢ LỜI CỦA BẠN" Foreground="{StaticResource TextMuted}"
                                                   FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                        <TextBox x:Name="TxtSpeakingTranscript" Style="{StaticResource MultilineTextBox}" Height="130"/>

                                        <TextBlock x:Name="TxtSpeechStatus" Text="" Foreground="{StaticResource TextMuted}"
                                                   FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>

                                        <!-- AI turn feedback -->
                                        <Border x:Name="CardTurnFeedback" Background="{StaticResource BgSubtle}"
                                                CornerRadius="10" Padding="14" Margin="0,12,0,0"
                                                Visibility="Collapsed" BorderBrush="{StaticResource BorderSubtle}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="PHẢN HỒI CHO CÂU VỪA TRẢ LỜI"
                                                               Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"
                                                               FontSize="11" VerticalAlignment="Center"/>
                                                    <Border Background="{StaticResource SuccessSoft}" CornerRadius="999"
                                                            Padding="10,3" HorizontalAlignment="Right">
                                                        <TextBlock x:Name="TxtTurnBand" Text="Chưa chấm"
                                                                   Foreground="{StaticResource SuccessGreen}"
                                                                   FontWeight="Bold" FontSize="12"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock x:Name="TxtTurnFeedback" TextWrapping="Wrap"
                                                           Foreground="{StaticResource BodyText}"
                                                           FontSize="12" LineHeight="20"/>
                                                <TextBlock x:Name="TxtTurnCriteria" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="11" Margin="0,6,0,0"/>
                                                <ItemsControl x:Name="ListTurnHighlights" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <Border Grid.Row="2" Background="{StaticResource BgSubtle}" CornerRadius="8"
                                        Padding="12" Margin="0,14,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button x:Name="BtnStartRecording" Content="●  Ghi âm"
                                                    Click="BtnStartRecording_Click" Padding="14,7" FontSize="12"
                                                    Margin="0,0,8,0"/>
                                            <Button x:Name="BtnStopRecording" Content="■  Dừng"
                                                    Style="{StaticResource DangerButton}" Click="BtnStopRecording_Click"
                                                    Padding="14,7" FontSize="12" Margin="0,0,8,0" IsEnabled="False"/>
                                            <Button x:Name="BtnPlayRecording" Content="▶  Nghe lại"
                                                    Style="{StaticResource SecondaryButton}" Click="BtnPlayRecording_Click"
                                                    Padding="14,7" FontSize="12" Margin="0,0,8,0" IsEnabled="False"/>
                                            <Button x:Name="BtnStartSpeechToText" Content="Nhận dạng giọng nói"
                                                    Background="{StaticResource AccentBlue}" Click="BtnStartSpeechToText_Click"
                                                    Padding="14,7" FontSize="12"/>
                                        </StackPanel>

                                        <Grid>
                                            <TextBlock x:Name="TxtRecordingStatus" Text="Chưa có bản ghi âm."
                                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="BtnSubmitTurn" Content="Gửi câu trả lời"
                                                    HorizontalAlignment="Right" Click="BtnSubmitTurn_Click"
                                                    Padding="20,9" FontWeight="Bold"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

                        <Border Grid.Column="2" Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="10" Padding="16">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Lịch sử vấn đáp" Style="{StaticResource TextH3}" FontSize="14"/>
                                    <TextBlock x:Name="TxtSpeakingStats" Text="0 lượt · 0 từ"
                                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Button x:Name="BtnFinalizeSpeaking" Content="Kết thúc &amp; chốt điểm Speaking"
                                            Background="{StaticResource SuccessGreen}" Click="BtnFinalizeSpeaking_Click"
                                            Padding="12,11" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>

                                <ListBox x:Name="ListSpeakingTurns" FontSize="11" BorderThickness="1">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding Header}" Foreground="{StaticResource AccentBlue}"
                                                           FontWeight="SemiBold" FontSize="11"/>
                                                <TextBlock Text="{Binding Answer}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource BodyText}"
                                                           FontSize="11" Margin="0,3,0,2"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Bottom action bar -->
                <Border Grid.Row="2" Background="{StaticResource BgSurface}"
                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                        CornerRadius="10" Padding="16,10" Margin="0,14,0,0">
                    <Grid VerticalAlignment="Center">
                        <TextBlock x:Name="TxtActionStatus" Text="Trạng thái: Đang làm bài..."
                                   Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Điền mẫu nhanh" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,10,0" Click="BtnFillDemoAnswers_Click" Padding="14,7" FontSize="12"/>
                            <Button x:Name="BtnSubmitCurrentSkill" Content="Nộp bài" Click="BtnSubmitCurrentSkill_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== VIEW 3: RESULT ==================== -->
            <Border x:Name="ViewResult" Visibility="Collapsed" Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                    CornerRadius="10" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Báo cáo chẩn đoán kết quả thi IELTS" Style="{StaticResource TextH1}"/>
                        <TextBlock Text="Phân tích 4 kỹ năng theo thang Band Cambridge"
                                   Style="{StaticResource TextSmall}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Overall band card -->
                        <Border Grid.Column="0" Background="{StaticResource BgSubtle}" CornerRadius="10" Padding="24">
                            <StackPanel HorizontalAlignment="Stretch">
                                <TextBlock Text="OVERALL BAND SCORE" Foreground="{StaticResource TextMuted}"
                                           FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>

                                <Border Background="{StaticResource PrimarySoft}" CornerRadius="999"
                                        Width="132" Height="132" Margin="0,16"
                                        HorizontalAlignment="Center"
                                        BorderBrush="{StaticResource PrimaryTeal}" BorderThickness="2">
                                    <TextBlock x:Name="TxtOverallBand" Text="--" Foreground="{StaticResource PrimaryTeal}"
                                               FontSize="40" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <Border Background="{StaticResource BgSurface}" CornerRadius="8" Padding="16"
                                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="CHI TIẾT 4 KỸ NĂNG" Foreground="{StaticResource TextMuted}"
                                                   FontWeight="SemiBold" FontSize="11" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="TxtScoreListening" Text="Listening: —"
                                                   Foreground="{StaticResource BodyText}" FontSize="13" Margin="0,3"/>
                                        <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,2"/>
                                        <TextBlock x:Name="TxtScoreReading" Text="Reading: —"
                                                   Foreground="{StaticResource BodyText}" FontSize="13" Margin="0,3"/>
                                        <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,2"/>
                                        <TextBlock x:Name="TxtScoreWriting" Text="Writing: —"
                                                   Foreground="{StaticResource BodyText}" FontSize="13" Margin="0,3"/>
                                        <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,2"/>
                                        <TextBlock x:Name="TxtScoreSpeaking" Text="Speaking: —"
                                                   Foreground="{StaticResource BodyText}" FontSize="13" Margin="0,3"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostic detail -->
                        <Border Grid.Column="2" Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="10" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Phân tích chẩn đoán chi tiết" Style="{StaticResource TextH3}"
                                               Margin="0,0,0,10"/>
                                    <TextBlock x:Name="TxtDiagnosticFeedback" TextWrapping="Wrap"
                                               Foreground="{StaticResource BodyText}" FontSize="14"
                                               LineHeight="23" Margin="0,0,0,18"/>

                                    <!--
                                        Hai khối dưới đây chứa dữ liệu do AI sinh ra (câu hỏi phản biện, bài mẫu).
                                        Thí sinh KHÔNG được xem theo quy chế khảo thí: AI chỉ hỗ trợ giảng viên.
                                        Giữ control (để không vỡ code-behind) nhưng ẩn hoàn toàn.

                                        Nếu sau này cần hiển thị lại (ví dụ chế độ luyện tập không tính điểm),
                                        đặt Visibility="Visible" và bật dữ liệu trong ShowFinalReportAsync.
                                    -->
                                    <Border Visibility="Collapsed" Background="{StaticResource SuccessSoft}"
                                            CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="CÂU HỎI PHẢN BIỆN THÍCH ỨNG (ADAPTIVE FOLLOW-UP)"
                                                       Foreground="{StaticResource SuccessGreen}" FontWeight="Bold"
                                                       FontSize="11" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="TxtAdaptiveQuestion" TextWrapping="Wrap"
                                                       Foreground="{StaticResource BodyText}"
                                                       FontSize="13" FontStyle="Italic" LineHeight="21"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Visibility="Collapsed" Background="{StaticResource BgSubtle}" CornerRadius="8" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="BÀI MẪU THAM KHẢO BAND 8.0+"
                                                       Foreground="{StaticResource TextMuted}" FontWeight="Bold"
                                                       FontSize="11" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="TxtModelAnswer" TextWrapping="Wrap"
                                                       Foreground="{StaticResource BodyText}"
                                                       FontSize="13" LineHeight="23"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Button Grid.Row="2" Content="Làm bài mới / Quay về đăng nhập"
                            HorizontalAlignment="Center" Height="42" Margin="0,20,0,0"
                            Style="{StaticResource SecondaryButton}" Click="BtnRestart_Click"/>
                </Grid>
            </Border>

            <!-- ==================== VIEW 4: TEACHER DASHBOARD ==================== -->
            <Grid x:Name="ViewTeacherDashboard" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- KPI CARDS -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BgSurface}"
                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="10" Padding="16,14" Margin="0,0,12,0">
                        <StackPanel>
                            <Border Background="{StaticResource AccentBlue}" Width="4" Height="18"
                                    HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,10"/>
                            <TextBlock Text="Ca thi đang giám sát" Foreground="{StaticResource TextMuted}"
                                       FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtKpiSessions" Text="0" Foreground="{StaticResource TextPrimary}"
                                       FontSize="28" FontWeight="Bold" Margin="0,4,0,2"/>
                            <TextBlock Text="Trạng thái trực tiếp" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource BgSurface}"
                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="10" Padding="16,14" Margin="0,0,12,0">
                        <StackPanel>
                            <Border Background="{StaticResource DangerRed}" Width="4" Height="18"
                                    HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,10"/>
                            <TextBlock Text="Cảnh báo vi phạm" Foreground="{StaticResource TextMuted}"
                                       FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtKpiViolations" Text="0" Foreground="{StaticResource DangerRed}"
                                       FontSize="28" FontWeight="Bold" Margin="0,4,0,2"/>
                            <TextBlock Text="Alt+Tab, Windows Key" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource BgSurface}"
                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="10" Padding="16,14" Margin="0,0,12,0">
                        <StackPanel>
                            <Border Background="{StaticResource WarningYellow}" Width="4" Height="18"
                                    HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,10"/>
                            <TextBlock Text="Bài chờ duyệt điểm" Foreground="{StaticResource TextMuted}"
                                       FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtKpiPending" Text="0" Foreground="{StaticResource WarningYellow}"
                                       FontSize="28" FontWeight="Bold" Margin="0,4,0,2"/>
                            <TextBlock Text="Human-in-the-loop" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="{StaticResource BgSurface}"
                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <Border Background="{StaticResource SuccessGreen}" Width="4" Height="18"
                                    HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,10"/>
                            <TextBlock Text="Điểm trung bình" Foreground="{StaticResource TextMuted}"
                                       FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtKpiAvgBand" Text="—" Foreground="{StaticResource SuccessGreen}"
                                       FontSize="28" FontWeight="Bold" Margin="0,4,0,2"/>
                            <TextBlock Text="Thang 9.0 IELTS" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Dash tabs -->
                <Border Grid.Row="1" Background="{StaticResource BgSubtle}" CornerRadius="8"
                        Padding="4" Margin="0,0,0,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnDashTabProctoring" Content="Giám sát phòng thi"
                                    Background="{StaticResource PrimaryTeal}" Foreground="White"
                                    Margin="0,0,4,0" Click="BtnDashTab_Click" Tag="Proctoring" Padding="16,8" FontSize="13"/>
                            <Button x:Name="BtnDashTabGrading" Content="Duyệt điểm"
                                    Background="Transparent" Foreground="{StaticResource BodyText}"
                                    Margin="0,0,4,0" Click="BtnDashTab_Click" Tag="Grading" Padding="16,8" FontSize="13"/>
                            <Button x:Name="BtnDashTabHistory" Content="Lịch sử đã chấm"
                                    Background="Transparent" Foreground="{StaticResource BodyText}"
                                    Margin="0,0,4,0" Click="BtnDashTab_Click" Tag="History" Padding="16,8" FontSize="13"/>
                            <Button x:Name="BtnDashTabExams" Content="Quản trị đề thi"
                                    Background="Transparent" Foreground="{StaticResource BodyText}"
                                    Click="BtnDashTab_Click" Tag="Exams" Padding="16,8" FontSize="13"/>
                        </StackPanel>

                        <Button x:Name="BtnRefreshDashboard" Content="Làm mới dữ liệu"
                                HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}"
                                Click="BtnRefreshDashboard_Click" Padding="14,7" FontSize="12"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <!-- PROCTORING -->
                    <Grid x:Name="PanelDashProctoring" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="10" Padding="16">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <TextBlock Text="Danh sách thí sinh" Style="{StaticResource TextH3}" FontSize="14"/>
                                    <TextBlock Text="Trạng thái trực tiếp từ phòng máy Kiosk"
                                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ListView x:Name="ListSessions" SelectionChanged="ListSessions_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Thí sinh" DisplayMemberBinding="{Binding CandidateName}" Width="140"/>
                                            <GridViewColumn Header="Tài khoản" DisplayMemberBinding="{Binding Username}" Width="80"/>
                                            <GridViewColumn Header="Trạng thái" DisplayMemberBinding="{Binding Status}" Width="90"/>
                                            <GridViewColumn Header="Vi phạm" DisplayMemberBinding="{Binding ViolationCount}" Width="60"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

                        <Border Grid.Column="2" Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="10" Padding="16">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <TextBlock Text="Nhật ký cảnh báo vi phạm" Style="{StaticResource TextH3}"
                                               FontSize="14" Foreground="{StaticResource DangerRed}"/>
                                    <TextBlock Text="Ghi nhận tự động bởi Win32 Hook, cập nhật realtime"
                                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                    <Border Background="{StaticResource BgSubtle}" CornerRadius="8"
                                            Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtManualViolationDesc" Grid.Column="0"
                                                     Text="Phát hiện thí sinh sử dụng thiết bị phụ trợ trái phép"
                                                     Margin="0,0,10,0"/>
                                            <Button Grid.Column="1" Content="Lập biên bản"
                                                    Style="{StaticResource DangerButton}"
                                                    Click="BtnAddManualViolation_Click" Padding="14,7" FontSize="12"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource DangerSoft}" CornerRadius="8" Padding="12"
                                            BorderBrush="{StaticResource DangerRed}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtSelectedSession"
                                                           Text="Chưa chọn ca thi (bấm vào danh sách bên trái)"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="Đình chỉ sẽ khóa ca thi: thí sinh không nộp bài được nữa."
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="BtnTerminateSession" Grid.Column="1"
                                                    Content="Đình chỉ ca thi"
                                                    Style="{StaticResource DangerButton}"
                                                    Click="BtnTerminateSession_Click"
                                                    Padding="14,7" FontWeight="Bold" FontSize="12"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <ListView x:Name="ListViolations">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Thời gian" DisplayMemberBinding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="80"/>
                                            <GridViewColumn Header="Thí sinh" DisplayMemberBinding="{Binding CandidateName}" Width="140"/>
                                            <GridViewColumn Header="Loại vi phạm" DisplayMemberBinding="{Binding ViolationType}" Width="130"/>
                                            <GridViewColumn Header="Chi tiết" DisplayMemberBinding="{Binding Description}" Width="330"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- GRADING -->
                    <Grid x:Name="PanelDashGrading" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="10" Padding="16">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <TextBlock Text="Bài thi chờ duyệt" Style="{StaticResource TextH3}" FontSize="14"/>
                                    <TextBlock Text="Writing / Speaking đã được AI chấm sơ bộ"
                                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>

                                <ListView x:Name="ListPendingReviews" SelectionChanged="ListPendingReviews_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgSubtle}" CornerRadius="6"
                                                    Padding="10" Margin="0,3" BorderBrush="{StaticResource BorderSubtle}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding CandidateName}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                                                        <TextBlock Text="{Binding SkillType}" HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource AccentBlue}" FontSize="11"
                                                                   FontWeight="SemiBold"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ProposedBand, StringFormat='AI đề xuất: Band {0:0.0}'}"
                                                               Foreground="{StaticResource SuccessGreen}"
                                                               FontSize="11" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding SubmittedAt, StringFormat='Nộp lúc {0:HH:mm:ss}'}"
                                                               Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

                        <Border Grid.Column="2" Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="10" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Background="{StaticResource BgSubtle}" CornerRadius="8" Padding="14"
                                            Margin="0,0,0,16" BorderBrush="{StaticResource BorderSubtle}"
                                            BorderThickness="1">
                                        <Grid>
                                            <StackPanel Margin="0,0,120,0">
                                                <TextBlock x:Name="TxtReviewCandidateTitle"
                                                           Text="Chưa chọn bài thi"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="Giáo viên điều chỉnh 4 tiêu chí Cambridge trước khi chốt"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Border Background="{StaticResource SuccessSoft}" CornerRadius="999"
                                                    Padding="12,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtReviewAiProposedBadge" Text="AI: —"
                                                           Foreground="{StaticResource SuccessGreen}"
                                                           FontWeight="Bold" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="NỘI DUNG BÀI LÀM" Foreground="{StaticResource TextMuted}"
                                               FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                    <Border Background="{StaticResource BgSubtle}" CornerRadius="8" Padding="14"
                                            Margin="0,0,0,16" BorderBrush="{StaticResource BorderSubtle}"
                                            BorderThickness="1">
                                        <TextBox x:Name="TxtReviewEssayContent" TextWrapping="Wrap" IsReadOnly="True"
                                                 Background="Transparent" Foreground="{StaticResource BodyText}"
                                                 FontSize="13" BorderThickness="0" Padding="0"
                                                 MaxHeight="160" VerticalScrollBarVisibility="Auto"/>
                                    </Border>

                                    <TextBlock Text="NHẬN XÉT SƠ BỘ CỦA AI" Foreground="{StaticResource TextMuted}"
                                               FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                    <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="14"
                                            Margin="0,0,0,16">
                                        <TextBlock x:Name="TxtReviewAiFeedback" Text="Chưa có nhận xét."
                                                   Foreground="{StaticResource BodyText}" FontSize="13"
                                                   TextWrapping="Wrap" LineHeight="21"/>
                                    </Border>

                                    <Border Background="{StaticResource BgSubtle}" CornerRadius="8" Padding="16"
                                            Margin="0,0,0,16" BorderBrush="{StaticResource BorderSubtle}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="ĐIỀU CHỈNH 4 TIÊU CHÍ CHẤM ĐIỂM"
                                                       Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"
                                                       FontSize="13" Margin="0,0,0,14"/>

                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="1. Task Response (25%)" Foreground="{StaticResource BodyText}" FontSize="12"/>
                                                <TextBlock x:Name="TxtValTR" Text="7.5" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource PrimaryTeal}" FontWeight="Bold"/>
                                            </Grid>
                                            <Slider x:Name="SliderTR" Minimum="1" Maximum="9" Value="7.5"
                                                    SmallChange="0.5" LargeChange="0.5" TickFrequency="0.5"
                                                    IsSnapToTickEnabled="True" Margin="0,0,0,12"
                                                    ValueChanged="CriteriaSlider_ValueChanged"/>

                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="2. Coherence &amp; Cohesion (25%)" Foreground="{StaticResource BodyText}" FontSize="12"/>
                                                <TextBlock x:Name="TxtValCC" Text="7.0" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource PrimaryTeal}" FontWeight="Bold"/>
                                            </Grid>
                                            <Slider x:Name="SliderCC" Minimum="1" Maximum="9" Value="7.0"
                                                    SmallChange="0.5" LargeChange="0.5" TickFrequency="0.5"
                                                    IsSnapToTickEnabled="True" Margin="0,0,0,12"
                                                    ValueChanged="CriteriaSlider_ValueChanged"/>

                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="3. Lexical Resource (25%)" Foreground="{StaticResource BodyText}" FontSize="12"/>
                                                <TextBlock x:Name="TxtValLR" Text="7.0" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource PrimaryTeal}" FontWeight="Bold"/>
                                            </Grid>
                                            <Slider x:Name="SliderLR" Minimum="1" Maximum="9" Value="7.0"
                                                    SmallChange="0.5" LargeChange="0.5" TickFrequency="0.5"
                                                    IsSnapToTickEnabled="True" Margin="0,0,0,12"
                                                    ValueChanged="CriteriaSlider_ValueChanged"/>

                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="4. Grammatical Range &amp; Accuracy (25%)" Foreground="{StaticResource BodyText}" FontSize="12"/>
                                                <TextBlock x:Name="TxtValGRA" Text="6.5" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource PrimaryTeal}" FontWeight="Bold"/>
                                            </Grid>
                                            <Slider x:Name="SliderGRA" Minimum="1" Maximum="9" Value="6.5"
                                                    SmallChange="0.5" LargeChange="0.5" TickFrequency="0.5"
                                                    IsSnapToTickEnabled="True" Margin="0,0,0,12"
                                                    ValueChanged="CriteriaSlider_ValueChanged"/>

                                            <Border Background="{StaticResource SuccessSoft}" CornerRadius="6" Padding="12">
                                                <TextBlock x:Name="TxtOfficialBandScore"
                                                           Text="ĐIỂM CHÍNH THỨC: --"
                                                           Foreground="{StaticResource SuccessGreen}"
                                                           FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="GHI CHÚ CỦA GIẢNG VIÊN" Foreground="{StaticResource TextMuted}"
                                               FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtTeacherFeedback" Style="{StaticResource MultilineTextBox}" Height="80" Margin="0,0,0,16"
                                             Text="Bài viết có cấu trúc chặt chẽ, luận điểm rõ ràng. Đã thẩm định và chốt điểm chính thức."/>

                                    <Button x:Name="BtnApproveScore" Content="Phê duyệt &amp; chốt điểm chính thức" Height="46"
                                            Background="{StaticResource SuccessGreen}" Click="BtnApproveScore_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- SUB-PANEL 3: LỊCH SỬ ĐÃ CHẤM -->
                    <Grid x:Name="PanelDashHistory" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Lịch sử bài đã chấm" Style="{StaticResource TextH3}" FontSize="14"/>
                                    <TextBlock x:Name="TxtHistorySummary" Text="Chưa có bài nào."
                                               HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="TxtHistoryKeyword" Grid.Column="0" Height="34" FontSize="13"
                                             ToolTip="Tìm theo tên thí sinh / username / tên đề" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CboHistorySkill" Grid.Column="1" Height="34" Margin="0,0,8,0"
                                              SelectionChanged="HistoryFilter_Changed" FontSize="12"/>
                                    <ComboBox x:Name="CboHistoryPeriod" Grid.Column="2" Height="34" Margin="0,0,8,0"
                                              SelectionChanged="HistoryFilter_Changed" FontSize="12"/>
                                    <ComboBox x:Name="CboHistorySort" Grid.Column="3" Height="34"
                                              SelectionChanged="HistoryFilter_Changed" FontSize="12"/>
                                    <Button Grid.Column="4" Content="Tìm" HorizontalAlignment="Left" Margin="8,0,0,0"
                                            Padding="18,7" FontSize="12" Click="BtnApplyHistoryFilter_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="10" Padding="16">
                            <Grid>
                                <TextBlock x:Name="TxtNoHistory" Text="Chưa có bài nào được chấm."
                                           Foreground="{StaticResource TextMuted}" FontSize="13"
                                           HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>

                                <ListView x:Name="ListGradedHistory" SelectionChanged="ListGradedHistory_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Ngày chấm" DisplayMemberBinding="{Binding ApprovedDateText}" Width="120"/>
                                            <GridViewColumn Header="Thí sinh" DisplayMemberBinding="{Binding CandidateName}" Width="150"/>
                                            <GridViewColumn Header="Kỹ năng" DisplayMemberBinding="{Binding SkillText}" Width="90"/>
                                            <GridViewColumn Header="AI đề xuất" DisplayMemberBinding="{Binding AiProposedText}" Width="90"/>
                                            <GridViewColumn Header="Điểm chốt" DisplayMemberBinding="{Binding OfficialText}" Width="90"/>
                                            <GridViewColumn Header="Người duyệt" DisplayMemberBinding="{Binding ApprovedBy}" Width="100"/>
                                            <GridViewColumn Header="Nhận xét" DisplayMemberBinding="{Binding TeacherFeedback}" Width="280"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ==================== VIEW 5: ADMIN EXAMS ==================== -->
            <Grid x:Name="ViewAdminExams" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgSurface}"
                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                        CornerRadius="10" Padding="18" Margin="0,0,0,14">
                    <Grid>
                        <StackPanel Margin="0,0,320,0">
                            <TextBlock Text="Quản trị đề thi" Style="{StaticResource TextH2}" FontSize="17"/>
                            <TextBlock Text="Tạo đề → thêm 4 phần thi → thêm câu hỏi và đáp án"
                                       Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Quay lại giám sát" Style="{StaticResource SecondaryButton}"
                                    Click="BtnAdminBack_Click" Padding="14,8" Margin="0,0,8,0" FontSize="12"/>
                            <Button Content="Làm mới" Style="{StaticResource SecondaryButton}"
                                    Click="BtnAdminRefresh_Click" Padding="14,8" Margin="0,0,8,0" FontSize="12"/>
                            <Button Content="Tạo đề mới" Background="{StaticResource PrimaryTeal}"
                                    Click="BtnAdminCreateExam_Click" Padding="14,8" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BgSurface}"
                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="10" Padding="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Danh sách đề thi" Style="{StaticResource TextH3}" FontSize="14"/>
                                <TextBlock Text="Chọn một đề để xem phần thi và câu hỏi"
                                           Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Button Content="Xóa đề đang chọn" Style="{StaticResource DangerOutlineButton}"
                                        Click="BtnAdminDeleteExam_Click" Padding="12,8" FontSize="12"/>
                            </StackPanel>

                            <ListBox x:Name="ListAdminExams" SelectionChanged="ListAdminExams_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                       TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0">
                                                <Run Text="{Binding SectionCount}"/><Run Text=" phần · "/>
                                                <Run Text="{Binding QuestionCount}"/><Run Text=" câu · "/>
                                                <Run Text="{Binding SessionCount}"/><Run Text=" ca thi"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

                    <Border Grid.Column="2" Background="{StaticResource BgSurface}"
                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="10" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="240"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TxtAdminExamTitle" Grid.Row="0" Text="Chưa chọn đề thi"
                                       Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"
                                       FontSize="14" Margin="0,0,0,12" TextWrapping="Wrap"/>

                            <Border Grid.Row="1" Background="{StaticResource BgSubtle}" CornerRadius="8" Padding="12">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="PHẦN THI (4 KỸ NĂNG)" Foreground="{StaticResource TextMuted}"
                                                   FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <Button x:Name="BtnAdminAddSection" Content="Thêm phần thi"
                                                Background="{StaticResource PrimaryTeal}" Click="BtnAdminAddSection_Click"
                                                Padding="12,6" FontSize="11"/>
                                    </StackPanel>
                                    <ListBox x:Name="ListAdminSections" Background="{StaticResource BgSurface}"
                                             BorderThickness="0" DisplayMemberPath="."
                                             SelectionChanged="ListAdminSections_SelectionChanged"/>
                                </DockPanel>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,12">
                                <Button Content="Thêm câu hỏi" x:Name="BtnAdminAddQuestion"
                                        Background="{StaticResource PrimaryTeal}"
                                        Click="BtnAdminAddQuestion_Click" Padding="12,7" FontSize="11"
                                        Margin="0,0,8,0" IsEnabled="False"/>
                                <Button Content="Xóa phần thi" x:Name="BtnAdminDeleteSection"
                                        Style="{StaticResource DangerOutlineButton}"
                                        Click="BtnAdminDeleteSection_Click" Padding="12,7" FontSize="11"
                                        Margin="0,0,8,0" IsEnabled="False"/>
                                <Button Content="Xóa câu hỏi" x:Name="BtnAdminDeleteQuestion"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BtnAdminDeleteQuestion_Click" Padding="12,7" FontSize="11"
                                        IsEnabled="False"/>
                            </StackPanel>

                            <ListView x:Name="ListAdminQuestions" Grid.Row="3"
                                      SelectionChanged="ListAdminQuestions_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="#" DisplayMemberBinding="{Binding QuestionNumber}" Width="45"/>
                                        <GridViewColumn Header="Loại" DisplayMemberBinding="{Binding QuestionType}" Width="130"/>
                                        <GridViewColumn Header="Nội dung" DisplayMemberBinding="{Binding QuestionText}" Width="290"/>
                                        <GridViewColumn Header="Đáp án" DisplayMemberBinding="{Binding CorrectAnswer}" Width="150"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================================================================
             FOOTER STATUS BAR
             ================================================================ -->
        <Border Grid.Row="2" Background="{StaticResource BgSubtle}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="TxtProctoringAlert"
                           Text="● Hệ thống sẵn sàng."
                           Foreground="{StaticResource SuccessGreen}" FontSize="12"/>
                <TextBlock Text="SmartIELTS v1.0 · .NET 8 WPF · Clean Architecture"
                           HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
