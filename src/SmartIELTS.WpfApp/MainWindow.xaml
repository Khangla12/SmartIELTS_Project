<Window x:Class="SmartIELTS.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SmartIELTS Examination System - Kiosk Mode" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0F172A"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Modern Color Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="BgSurface" Color="#1E293B"/>
        <SolidColorBrush x:Key="BgCard" Color="#334155"/>
        <SolidColorBrush x:Key="PrimaryTeal" Color="#0D9488"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#38BDF8"/>
        <SolidColorBrush x:Key="TextLight" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningYellow" Color="#F59E0B"/>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryTeal}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="64"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Status Bar -->
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource PrimaryTeal}" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="AI" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="SMARTIELTS EXAM PLATFORM" Foreground="{StaticResource TextLight}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="SWD392 Architecture &amp; PRN222 .NET 8" Foreground="{StaticResource AccentBlue}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Active Test Info & Timer -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#334155" CornerRadius="20" Padding="14,4" Margin="0,0,15,0">
                        <TextBlock x:Name="TxtCandidateBadge" Text="Thí sinh: Chưa đăng nhập" Foreground="{StaticResource TextLight}" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="20" Padding="14,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱ Thời gian còn lại: " Foreground="#A5B4FC" FontSize="13"/>
                            <TextBlock x:Name="TxtTimer" Text="165:00" Foreground="#38BDF8" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Kiosk Mode Indicator & Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BadgeKiosk" Background="#064E3B" BorderBrush="{StaticResource SuccessGreen}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtKioskStatus" Text="🔒 KIOSK LOCK ACTIVE" Foreground="{StaticResource SuccessGreen}" FontSize="11" FontWeight="Bold"/>
                    </Border>

                    <Button Content="Tạm dừng Lock (Demo)" Background="#475569" Margin="0,0,8,0" Click="BtnToggleKiosk_Click" Padding="10,6" FontSize="12"/>
                    <Button Content="Thoát Kiosk" Background="{StaticResource DangerRed}" Click="BtnExitApp_Click" Padding="10,6" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY VIEW SWITCHER -->
        <Grid Grid.Row="1" Margin="20">
            <!-- VIEW 1: LOGIN & HARDWARE CHECK -->
            <Border x:Name="ViewLogin" Background="{StaticResource BgSurface}" CornerRadius="12" Padding="40" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Đăng Nhập Ca Thi IELTS" Foreground="{StaticResource TextLight}" FontSize="24" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    <TextBlock Text="Xác thực danh tính và kiểm tra thiết bị phần cứng trước khi vào Kiosk" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,0,0,24" HorizontalAlignment="Center"/>

                    <TextBlock Text="Tài khoản:" Foreground="{StaticResource TextLight}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtUsername" Text="student" Margin="0,0,0,14"/>

                    <TextBlock Text="Mật khẩu:" Foreground="{StaticResource TextLight}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="TxtPassword" Password="Student@123" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="10,6" FontSize="14" Margin="0,0,0,20"/>

                    <!-- Hardware Check Card -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Kiểm tra Thiết bị Giám thị (Hardware Readiness)" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="✓ Camera Web: Đã nhận diện sẵn sàng cho AI Face Tracking" Foreground="{StaticResource SuccessGreen}" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="✓ Microphone: NAudio Input chuẩn 44.1kHz (Sẵn sàng Speaking)" Foreground="{StaticResource SuccessGreen}" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="✓ Kiosk Mode Hook: Đã nạp SetWindowsHookEx (Chặn Alt+Tab, Windows Key)" Foreground="{StaticResource SuccessGreen}" FontSize="12" Margin="0,2"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Vào Phòng Thi Khóa Máy (Bắt Đầu Ca Thi)" Height="46" Click="BtnStartExam_Click"/>
                </StackPanel>
            </Border>

            <!-- VIEW 2: EXAM WORKSPACE (LISTENING / READING / WRITING / SPEAKING) -->
            <Grid x:Name="ViewExam" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <!-- Skill Tabs Navigation -->
                <Border Grid.Row="0" Background="{StaticResource BgSurface}" CornerRadius="8" Padding="10,0" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="TabListening" Content="🎧 1. LISTENING (30m)" Background="{StaticResource PrimaryTeal}" Margin="0,0,10,0" Click="TabSkill_Click" Tag="Listening"/>
                        <Button x:Name="TabReading" Content="📖 2. READING (60m)" Background="#475569" Margin="0,0,10,0" Click="TabSkill_Click" Tag="Reading"/>
                        <Button x:Name="TabWriting" Content="✍️ 3. WRITING (60m)" Background="#475569" Margin="0,0,10,0" Click="TabSkill_Click" Tag="Writing"/>
                        <Button x:Name="TabSpeaking" Content="🎙️ 4. SPEAKING (15m)" Background="#475569" Margin="0,0,10,0" Click="TabSkill_Click" Tag="Speaking"/>
                    </StackPanel>
                </Border>

                <!-- Skill Content Panels -->
                <Grid Grid.Row="1">
                    <!-- SUB-VIEW: LISTENING -->
                    <Grid x:Name="PanelListening" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Listening Audio Bar -->
                        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="▶ Audio Section 1: Customer Hotel Reservation (Audio phát 1 lần - Khóa tua)" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Value="45" Maximum="100" Height="8" Margin="20,0" Background="#334155" Foreground="{StaticResource PrimaryTeal}"/>
                                <TextBlock Grid.Column="2" Text="Volume: 100% (Locked)" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Listening Questions -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="StackListeningQuestions" Background="{StaticResource BgSurface}" Margin="0,0,0,10"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- SUB-VIEW: READING (SPLIT-SCREEN) -->
                    <Grid x:Name="PanelReading" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Split-Screen Reading Passage with Highlight Toolbar -->
                        <Border Grid.Column="0" Background="{StaticResource BgSurface}" CornerRadius="8" Padding="20">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#334155" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Công cụ đọc:" Foreground="{StaticResource TextLight}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Content="Highlight Vàng" Background="#EAB308" Foreground="Black" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="BtnHighlight_Click"/>
                                        <Button Content="Ghi chú nhanh" Background="#64748B" Padding="8,4" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="TxtReadingPassage" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="#E2E8F0" FontSize="14" BorderThickness="0"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#334155"/>

                        <!-- Right: Questions -->
                        <Border Grid.Column="2" Background="{StaticResource BgSurface}" CornerRadius="8" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="StackReadingQuestions"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- SUB-VIEW: WRITING -->
                    <Grid x:Name="PanelWriting" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Prompt & Cambridge Rubric -->
                        <Border Grid.Column="0" Background="{StaticResource BgSurface}" CornerRadius="8" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="ĐỀ BÀI IELTS WRITING" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
                                    <TextBlock x:Name="TxtWritingPrompt" TextWrapping="Wrap" Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,20"/>

                                    <Border Background="#334155" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="4 TIÊU CHÍ CHẤM CAMBRIDGE" Foreground="{StaticResource WarningYellow}" FontWeight="Bold" Margin="0,0,0,8"/>
                                            <TextBlock Text="• Task Response (TR - 25%): Viết tối thiểu 250 từ, lập luận đúng trọng tâm" Foreground="{StaticResource TextLight}" FontSize="12" Margin="0,2"/>
                                            <TextBlock Text="• Coherence &amp; Cohesion (CC - 25%): Bố cục logic, liên từ chặt chẽ" Foreground="{StaticResource TextLight}" FontSize="12" Margin="0,2"/>
                                            <TextBlock Text="• Lexical Resource (LR - 25%): Vốn từ học thuật C1/C2" Foreground="{StaticResource TextLight}" FontSize="12" Margin="0,2"/>
                                            <TextBlock Text="• Grammatical Range (GRA - 25%): Đa dạng và chuẩn xác cấu trúc" Foreground="{StaticResource TextLight}" FontSize="12" Margin="0,2"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#334155"/>

                        <!-- Right: Editor & Live Word Count -->
                        <Border Grid.Column="2" Background="{StaticResource BgSurface}" CornerRadius="8" Padding="20">
                            <DockPanel>
                                <Border DockPanel.Dock="Bottom" Background="#1E1B4B" CornerRadius="6" Padding="14,8" Margin="0,10,0,0">
                                    <Grid>
                                        <TextBlock x:Name="TxtWordCount" Text="Số từ: 0 / 250 từ (Tự động khóa lệnh Paste từ Clipboard)" Foreground="#A5B4FC" FontWeight="Bold"/>
                                        <TextBlock Text="💾 Tự động lưu nháp mỗi 10 giây (Offline-First)" HorizontalAlignment="Right" Foreground="{StaticResource SuccessGreen}" FontSize="12"/>
                                    </Grid>
                                </Border>
                                <TextBox x:Name="TxtEssayEditor" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="15"
                                         TextChanged="TxtEssayEditor_TextChanged" PreviewKeyDown="TxtEssayEditor_PreviewKeyDown"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- SUB-VIEW: SPEAKING -->
                    <Border x:Name="PanelSpeaking" Visibility="Collapsed" Background="{StaticResource BgSurface}" CornerRadius="8" Padding="30">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="IELTS SPEAKING EXAM - GIÁM KHẢO ẢO AI &amp; HỎI XOÁY THÍCH ỨNG" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtSpeakingPrompt" TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="14" Margin="0,0,0,20"/>
                            </StackPanel>

                            <!-- Audio visualizer & Simulation -->
                            <Border Grid.Row="1" Background="#0F172A" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Background="#1E293B" CornerRadius="50" Width="100" Height="100" Margin="0,0,0,15">
                                        <TextBlock Text="🎙️" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="TxtMicStatus" Text="Microphone Sẵn Sàng Ghi Âm" Foreground="{StaticResource SuccessGreen}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Nói câu trả lời của bạn vào microphone. Hệ thống sẽ ghi âm và Azure AI sẽ chấm âm vị (Phoneme)." Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                                    <TextBox x:Name="TxtSpeakingTranscript" Width="600" Height="90" TextWrapping="Wrap" AcceptsReturn="True" 
                                             Text="I believe artificial intelligence offers profound benefits in education; furthermore, it acts as a catalyst for personalised learning experiences for students."/>
                                </StackPanel>
                            </Border>

                            <Button Grid.Row="2" Content="Hoàn Tất Phần Trả Lời &amp; Gửi Cho AI Chấm Âm Vị" Height="46" Click="BtnSubmitSpeaking_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bottom Action Controls -->
                <Border Grid.Row="2" Background="{StaticResource BgSurface}" CornerRadius="8" Padding="20,0" Margin="0,15,0,0">
                    <Grid VerticalAlignment="Center">
                        <TextBlock x:Name="TxtActionStatus" Text="Trạng thái: Đang làm bài..." Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <Button x:Name="BtnSubmitCurrentSkill" Content="Nộp Bài Kỹ Năng Này &amp; Chấm Điểm" HorizontalAlignment="Right" Click="BtnSubmitCurrentSkill_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- VIEW 3: RESULT & DIAGNOSTIC REPORT (RADAR CHART & AI FEEDBACK) -->
            <Border x:Name="ViewResult" Visibility="Collapsed" Background="{StaticResource BgSurface}" CornerRadius="12" Padding="30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="BÁO CÁO CHẨN ĐOÁN KẾT QUẢ THI IELTS (DIAGNOSTIC REPORT)" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="20"/>
                        <TextBlock Text="Kết quả phân tích đa chiều 4 kỹ năng theo chuẩn Cambridge Band Descriptors" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Overall Band Summary Card -->
                        <Border Grid.Column="0" Background="#0F172A" CornerRadius="12" Padding="24" Margin="0,0,20,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="OVERALL BAND SCORE" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                <Border Background="{StaticResource PrimaryTeal}" CornerRadius="50" Width="100" Height="100" Margin="0,15">
                                    <TextBlock x:Name="TxtOverallBand" Text="7.5" Foreground="White" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="CHI TIẾT 4 KỸ NĂNG" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="TxtScoreListening" Text="🎧 Listening: Band 7.5 (4/5 câu)" Foreground="{StaticResource TextLight}" Margin="0,2"/>
                                        <TextBlock x:Name="TxtScoreReading" Text="📖 Reading: Band 7.0 (4/5 câu)" Foreground="{StaticResource TextLight}" Margin="0,2"/>
                                        <TextBlock x:Name="TxtScoreWriting" Text="✍️ Writing: Band 7.0 (AI Evaluated)" Foreground="{StaticResource TextLight}" Margin="0,2"/>
                                        <TextBlock x:Name="TxtScoreSpeaking" Text="🎙️ Speaking: Band 7.5 (AI Examiner)" Foreground="{StaticResource TextLight}" Margin="0,2"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Right: Detailed AI Diagnostic Feedback & Color Highlights -->
                        <Border Grid.Column="1" Background="#0F172A" CornerRadius="12" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="PHÂN TÍCH CHẨN ĐOÁN CHI TIẾT CỦA AI (HUMAN-IN-THE-LOOP)" Foreground="{StaticResource WarningYellow}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="TxtDiagnosticFeedback" TextWrapping="Wrap" Foreground="#E2E8F0" FontSize="14" LineHeight="22" Margin="0,0,0,20"/>

                                    <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="ĐIỂM SÁNG ĐỒ ÁN: HỎI XOÁY THÍCH ỨNG (ADAPTIVE FOLLOW-UP)" Foreground="{StaticResource SuccessGreen}" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="TxtAdaptiveQuestion" TextWrapping="Wrap" Foreground="#67E8F9" FontSize="13" FontStyle="Italic"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#1E293B" CornerRadius="8" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="BÀI MẪU BAND 8.0+ DO AI TỰ ĐỘNG VIẾT LẠI (MODEL REWRITE)" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="TxtModelAnswer" TextWrapping="Wrap" Foreground="#E2E8F0" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Button Grid.Row="2" Content="Làm Bài Thi Mới / Quay Về Đăng Nhập" HorizontalAlignment="Center" Height="40" Margin="0,20,0,0" Click="BtnRestart_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource BgSurface}" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="TxtProctoringAlert" Text="● Giám thị Kiosk: Bình thường. Đang bảo vệ bài thi." Foreground="{StaticResource SuccessGreen}" FontSize="12"/>
                <TextBlock Text="SmartIELTS Examination System v1.0 • .NET 8 WPF • Clean Architecture" HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
